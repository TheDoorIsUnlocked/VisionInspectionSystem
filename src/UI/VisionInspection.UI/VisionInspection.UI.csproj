<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="HandyControl" Version="3.4.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.10.0.20241108" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\VisionInspection.Core\VisionInspection.Core.csproj" />
    <ProjectReference Include="..\..\Modules\VisionInspection.Modules.SOP\VisionInspection.Modules.SOP.csproj" />
    <ProjectReference Include="..\..\Modules\VisionInspection.Modules.Detection\VisionInspection.Modules.Detection.csproj" />
    <ProjectReference Include="..\VisionInspection.Converters\VisionInspection.Converters.csproj" />
  </ItemGroup>

  <!-- 海康相机SDK引用 -->
  <ItemGroup>
    <Reference Include="MvCameraControl.Net">
      <HintPath>E:\yolo\YoloDotNet-master\VisionInspectionSystem\libs\MvCameraControl.Net.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- 确保SDK DLL复制到输出目录 -->
  <ItemGroup>
    <None Include="E:\yolo\YoloDotNet-master\VisionInspectionSystem\libs\MvCameraControl.Net.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- SOP配置文件：用通配符包含 configs/sop 下所有 yaml，以后新增 SOP 不用改 csproj -->
  <ItemGroup>
    <None Update="configs\sop_config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="configs\sop\regions\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="configs\sop\*.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- MediaPipe手部检测模型文件 -->
  <ItemGroup>
    <None Update="models\palm_detection_full_Nx3x192x192_post.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="models\hand_landmark_sparse_Nx3x224x224.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- YOLOv8-pose模型文件（用于手部检测） -->
  <ItemGroup>
    <None Include="..\..\..\..\Models\yolov8s-pose.onnx">
      <Link>Models\yolov8s-pose.onnx</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\..\..\Models\yolov11s-pose.onnx">
      <Link>Models\yolov11s-pose.onnx</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- SOP 音频反馈文件（ok.wav / ng.wav）：复制到输出目录，运行时由 MainViewModel 定位播放 -->
  <ItemGroup>
    <None Include="..\..\..\ok.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\..\ng.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
