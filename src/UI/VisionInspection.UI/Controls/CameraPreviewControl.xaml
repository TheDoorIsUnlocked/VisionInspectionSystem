<UserControl x:Class="VisionInspection.UI.Controls.CameraPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             xmlns:viewModels="clr-namespace:VisionInspection.UI.ViewModels">
    <Grid Background="#222">
        <!-- 视频画面：SKElement 按 Uniform 缩放绘制 -->
        <skia:SKElement x:Name="PreviewCanvas"
                        PaintSurface="OnPaintSurface"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>

        <!-- 无画面提示 -->
        <TextBlock Text="等待相机画面..."
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#888" FontSize="14"
                   Visibility="{Binding CurrentImage, Converter={StaticResource Object2VisibilityReConverter}}"/>

        <!-- 相机名标签（左下角） -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="4"
                Background="#66000000" CornerRadius="3" Padding="6,2">
            <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="12"/>
        </Border>

        <!-- 协同报警红框 -->
        <Border BorderBrush="#FF4D4F" BorderThickness="4" CornerRadius="2"
                Visibility="{Binding IsAlerting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </Grid>
</UserControl>
