{
  "name": "水杯使用场景 - 区域定义",
  "description": "定义拿起水杯、喝水、放回水杯场景中的关键区域（坐标须用「🎯 标定区域」工具按真机画面重设）",
  "version": "1.0",
  "imageSize": {
    "width": 1280,
    "height": 720
  },
  "regions": {
    "cup_table": {
      "id": "cup_table",
      "name": "水杯放置区",
      "description": "水杯平时放在桌面的位置（拿起=手离开此区；放下=手到达此区）",
      "type": "rectangle",
      "coordinates": {
        "x1": 200,
        "y1": 400,
        "x2": 350,
        "y2": 550
      },
      "color": "#4CAF50",
      "allowedActions": ["放置水杯", "拿起水杯"]
    },
    "mouth_region": {
      "id": "mouth_region",
      "name": "嘴边区域",
      "description": "喝水时手/杯子应到达的嘴边位置（必须对准你的嘴，否则'喝水'永远超时）",
      "type": "rectangle",
      "coordinates": {
        "x1": 430,
        "y1": 220,
        "x2": 540,
        "y2": 320
      },
      "color": "#2196F3",
      "allowedActions": ["喝水"]
    }
  },
  "keypoints": {
    "left_hand": {
      "id": "left_hand",
      "name": "左手",
      "keypointType": "LeftWrist",
      "description": "左手腕位置，用于检测拿水杯的手"
    },
    "right_hand": {
      "id": "right_hand",
      "name": "右手",
      "keypointType": "RightWrist",
      "description": "右手腕位置，用于检测拿水杯的手"
    },
    "nose": {
      "id": "nose",
      "name": "鼻子",
      "keypointType": "Nose",
      "description": "鼻子位置，用于判断头部朝向/嘴边位置参考"
    }
  },
  "rules": {
    "pickup_cup": {
      "id": "pickup_cup",
      "name": "拿起水杯",
      "description": "手从水杯放置区离开",
      "conditions": [
        {
          "type": "hand_leave_region",
          "hand": "any",
          "region": "cup_table",
          "description": "手离开水杯放置区"
        }
      ]
    },
    "drink_water": {
      "id": "drink_water",
      "name": "用杯子喝水",
      "description": "手在嘴边区域稳定停留",
      "conditions": [
        {
          "type": "hand_in_region",
          "hand": "any",
          "region": "mouth_region",
          "duration": 1000,
          "description": "手在嘴边区域停留1秒"
        }
      ]
    },
    "put_down_cup": {
      "id": "put_down_cup",
      "name": "放回水杯",
      "description": "手将水杯从嘴边放回放置区",
      "conditions": [
        {
          "type": "hand_in_region",
          "hand": "any",
          "region": "cup_table",
          "duration": 500,
          "description": "手在放置区停留500ms"
        }
      ]
    }
  },
  "forbiddenZones": {},
  "calibration": {
    "note": "这些坐标基于1280x720分辨率的摄像头，为默认模板，须按真机画面重新标定",
    "adjustmentGuide": "如果实际摄像头分辨率不同，请按比例调整坐标；请用程序内「🎯 标定区域」工具可视化重设"
  }
}
