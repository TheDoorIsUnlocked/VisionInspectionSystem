{
  "SOPModule": {
    "ModelPath": "yolo_models/yolov8s.onnx",
    "UseGpu": false,
    "ConfidenceThreshold": 0.6,
    "IouThreshold": 0.45,
    "PoseEstimation": {
      "Enabled": true,
      "ModelPath": "yolo_models/yolov8s-pose.onnx"
    }
  },
  "RegionConfigPath": "configs/sop/regions/cup_usage_regions.json",
  "WorkflowPath": "configs/sop/sop_cup_usage.yaml",
  "DetectionMode": "PoseBased",
  "HandDetectionBackend": "MediaPipe",
  "HandPoseEstimation": {
    "UseGpu": true
  },
  "Steps": [
    {
      "Id": "idle",
      "Name": "等待",
      "Description": "等待人员开始操作",
      "Icon": "⏳"
    },
    {
      "Id": "pickup_cup",
      "Name": "拿起水杯",
      "Description": "检测手从桌面拿起水杯动作",
      "Icon": "🥤"
    },
    {
      "Id": "drink_water",
      "Name": "用杯子喝水",
      "Description": "检测手举杯到嘴边喝水",
      "Icon": "💧"
    },
    {
      "Id": "put_down_cup",
      "Name": "放回水杯",
      "Description": "检测手将水杯放回桌面",
      "Icon": "✋"
    },
    {
      "Id": "complete",
      "Name": "完成",
      "Description": "SOP流程执行完成",
      "Icon": "✅"
    }
  ]
}
