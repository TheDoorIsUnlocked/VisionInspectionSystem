<Window x:Class="VisionInspection.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VisionInspection.UI"
        xmlns:controls="clr-namespace:VisionInspection.UI.Controls"
        xmlns:viewModels="clr-namespace:VisionInspection.UI.ViewModels"
        mc:Ignorable="d"
        Title="视觉检测系统 - ROI编辑器" Height="600" Width="1000">
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content="加载图像" Command="{Binding LoadImageCommand}" Margin="0,0,10,0" />
            <Button Content="保存ROI" Command="{Binding SaveROIsCommand}" Margin="0,0,10,0" />
            <Button Content="清空ROI" Command="{Binding ClearROIsCommand}" Margin="0,0,10,0" />
            
            <Separator Width="2" Height="20" Background="Gray" Margin="0,0,10,0" />
            
            <TextBlock Text="形状类型: " VerticalAlignment="Center" Margin="0,0,5,0" />
            <ComboBox SelectedValue="{Binding ROIEditorViewModel.CurrentShapeType}" Width="100">
                <ComboBoxItem Tag="0">矩形</ComboBoxItem>
                <ComboBoxItem Tag="1">圆形</ComboBoxItem>
            </ComboBox>
        </StackPanel>
        
        <!-- ROI编辑器 -->
        <controls:ROIEditorControl 
            Grid.Row="1" 
            ViewModel="{Binding ROIEditorViewModel}" 
            Margin="10" />
        
        <!-- 状态栏 -->
        <StatusBar Grid.Row="2" Height="25">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
