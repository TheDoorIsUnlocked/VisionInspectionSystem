<Window x:Class="VisionInspection.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VisionInspection.UI"
        xmlns:controls="clr-namespace:VisionInspection.UI.Controls"
        xmlns:views="clr-namespace:VisionInspection.UI.Views"
        xmlns:viewModels="clr-namespace:VisionInspection.UI.ViewModels"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="视觉检测系统" Height="700" Width="1400"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2196F3" Height="50">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="视觉检测系统" 
                          Foreground="White" FontSize="20" FontWeight="Bold"
                          VerticalAlignment="Center" Margin="20,0" />
            </Grid>
        </Border>

        <!-- 菜单栏 -->
        <Menu Grid.Row="1" Background="White" Height="32">
            <MenuItem Header="系统">
                <MenuItem x:Name="UserManagementMenuItem" Header="用户管理" Click="UserManagementMenuItem_Click"/>
                <MenuItem Header="修改密码" Click="ChangePasswordMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="退出登录" Click="LogoutMenuItem_Click"/>
                <MenuItem Header="退出程序" Click="ExitMenuItem_Click"/>
            </MenuItem>
            
            <MenuItem Header="图像">
                <MenuItem Header="📁 加载图像" Command="{Binding LoadImageCommand}"/>
                <MenuItem Header="🎬 加载视频" Command="{Binding LoadVideoCommand}"/>
                <Separator/>
                <MenuItem Header="💾 保存ROI" Command="{Binding SaveROIsCommand}"/>
                <MenuItem Header="🗑️ 清空ROI" Command="{Binding ClearROIsCommand}"/>
                <Separator/>
                <MenuItem Header="ROI工具">
                    <MenuItem Header="✏️ 创建ROI" IsCheckable="True" 
                             IsChecked="{Binding RoiEditorViewModel.IsCreatingROI}"/>
                    <Separator/>
                    <MenuItem x:Name="ShapeRectangleMenuItem" Header="矩形" IsCheckable="True" IsChecked="True" Click="ShapeRectangleMenuItem_Click"/>
                    <MenuItem x:Name="ShapeCircleMenuItem" Header="圆形" IsCheckable="True" Click="ShapeCircleMenuItem_Click"/>
                </MenuItem>
            </MenuItem>
            
            <MenuItem Header="检测">
                <MenuItem Header="🧠 加载模型" Command="{Binding LoadModelCommand}"/>
                <TextBlock Text="{Binding LoadedModelName, StringFormat='当前模型: {0}'}" 
                          Margin="20,5" Foreground="Gray"/>
                <Separator/>
                <MenuItem Header="🔍 图像检测" Command="{Binding RunDetectionCommand}"/>
                <MenuItem Header="🎬 视频推理" Command="{Binding StartVideoInferenceCommand}"/>
                <MenuItem Header="⏹️ 停止推理" Command="{Binding StopVideoInferenceCommand}"/>
                <Separator/>
                <MenuItem Header="🗑️ 清除结果" Command="{Binding ClearDetectionResultsCommand}"/>
            </MenuItem>
            
            <MenuItem Header="SOP">
                <MenuItem Header="▶️ 启动SOP实时检测" Command="{Binding StartSOPDetectionCommand}"/>
                <MenuItem Header="⏹️ 停止SOP检测" Command="{Binding StopSOPDetectionCommand}"/>
                <MenuItem Header="🔄 重置SOP工作流" Command="{Binding ResetSOPWorkflowCommand}"/>
                <MenuItem Header="📂 切换SOP工作流" Command="{Binding SwitchSOPWorkflowCommand}"/>
            </MenuItem>
            
            <MenuItem Header="视图">
                <MenuItem Header="📋 ROI列表" IsCheckable="True" IsChecked="True" 
                         x:Name="ShowROIPanelMenuItem" Click="ShowROIPanelMenuItem_Click"/>
            </MenuItem>
            
            <MenuItem Header="配置">
                <MenuItem Header="相机配置" Click="CameraConfigMenuItem_Click"/>
                <MenuItem Header="模型管理" Click="ModelManagementMenuItem_Click"/>
                <MenuItem Header="通信设置" Click="CommunicationConfigMenuItem_Click"/>
            </MenuItem>
            
            <MenuItem Header="帮助">
                <MenuItem Header="关于" Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <!-- 简化工具栏 - 只保留常用操作 -->
        <ToolBarTray Grid.Row="2" Background="#F5F5F5" Margin="0,2">
            <ToolBar Band="0" BandIndex="0" Background="Transparent">
                <!-- 文件操作组 -->
                <Button Content="📁" ToolTip="加载图像" Command="{Binding LoadImageCommand}"
                        Style="{StaticResource ButtonPrimary}" Margin="2" Padding="8,4"/>
                <Button Content="🎬" ToolTip="加载视频" Command="{Binding LoadVideoCommand}"
                        Style="{StaticResource ButtonPrimary}" Margin="2" Padding="8,4"/>
                <Separator Margin="5,0"/>
                
                <!-- ROI工具组 -->
                <ToggleButton ToolTip="创建ROI" Padding="8,4" Margin="2"
                             IsChecked="{Binding RoiEditorViewModel.IsCreatingROI}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="#CCCCCC"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Content" Value="✏️"/>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="#2196F3"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <ComboBox Width="80" VerticalAlignment="Center" Margin="2" ToolTip="ROI形状"
                         SelectedIndex="0" SelectionChanged="ShapeComboBox_SelectionChanged">
                    <ComboBoxItem Content="矩形"/>
                    <ComboBoxItem Content="圆形"/>
                </ComboBox>
                <Separator Margin="5,0"/>
                
                <!-- 模型和检测组 -->
                <Button Content="🧠" ToolTip="加载模型" Command="{Binding LoadModelCommand}"
                        Style="{StaticResource ButtonInfo}" Margin="2" Padding="8,4"/>
                <TextBlock Text="{Binding LoadedModelName}" VerticalAlignment="Center" Margin="5,0" Width="100"
                          TextTrimming="CharacterEllipsis" ToolTip="{Binding LoadedModelName}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Gray"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsModelLoaded}" Value="True">
                                    <Setter Property="Foreground" Value="Green"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Content="🔍" ToolTip="开始检测" Command="{Binding RunDetectionCommand}"
                        Style="{StaticResource ButtonSuccess}" Margin="2" Padding="8,4">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{StaticResource BooleanAndConverter}">
                            <Binding Path="IsModelLoaded"/>
                            <Binding Path="IsVideoPlaying" Converter="{StaticResource Boolean2BooleanReConverter}"/>
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>
                <Separator Margin="5,0"/>
                
                <!-- 视频推理组 -->
                <Button Content="▶️" ToolTip="开始视频推理" Command="{Binding StartVideoInferenceCommand}"
                        Style="{StaticResource ButtonSuccess}" Margin="2" Padding="8,4">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{StaticResource BooleanAndConverter}">
                            <Binding Path="IsModelLoaded"/>
                            <Binding Path="IsVideoPlaying" Converter="{StaticResource Boolean2BooleanReConverter}"/>
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>
                <Button Content="⏹️" ToolTip="停止推理" Command="{Binding StopVideoInferenceCommand}" 
                        Margin="2" Padding="8,4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonDanger}">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVideoPlaying}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="{Binding CurrentFrameIndex, StringFormat='帧: {0}'}" 
                          VerticalAlignment="Center" Margin="5,0" Width="80"
                          Visibility="{Binding IsVideoPlaying, Converter={StaticResource Boolean2VisibilityConverter}}"/>
                <Separator Margin="5,0"/>
                
                <!-- 实时相机检测组 -->
                <Button Content="📷" ToolTip="开始实时检测" Command="{Binding StartRealTimeDetectionCommand}"
                        Margin="2" Padding="8,4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonSuccess}">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsModelLoaded}" Value="True"/>
                                        <Condition Binding="{Binding IsRealTimeDetecting}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="IsEnabled" Value="True"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="🛑" ToolTip="停止实时检测" Command="{Binding StopRealTimeDetectionCommand}" 
                        Margin="2" Padding="8,4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonDanger}">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRealTimeDetecting}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Separator Margin="5,0"/>
                
                <!-- 图像旋转控制 -->
                <Button Content="↺" ToolTip="向左旋转90°" Click="RotateLeftButton_Click"
                        Style="{StaticResource ButtonPrimary}" Margin="2" Padding="8,4"/>
                <Button Content="↻" ToolTip="向右旋转90°" Click="RotateRightButton_Click"
                        Style="{StaticResource ButtonPrimary}" Margin="2" Padding="8,4"/>
                <TextBlock Text="{Binding RoiEditorViewModel.ImageRotationAngle, StringFormat='{}{0}°'}" 
                          VerticalAlignment="Center" Margin="5,0" Width="40"/>

            </ToolBar>
        </ToolBarTray>

        <!-- 主内容区 -->
        <Grid Grid.Row="3" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" MinWidth="200" MaxWidth="500" />
            </Grid.ColumnDefinitions>

            <!-- 图像显示区 -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Background="#333"
                    CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <controls:ROIEditorControl 
                        ViewModel="{Binding RoiEditorViewModel}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>
                    
                    <!-- 提示信息 -->
                    <TextBlock Text="点击'加载图像'按钮选择图片" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="White" FontSize="16"
                              Visibility="{Binding RoiEditorViewModel.CurrentImage, Converter={StaticResource Object2VisibilityReConverter}}"/>
                </Grid>
            </Border>

            <!-- 拖动分隔条 -->
            <GridSplitter Grid.Column="1" 
                          Width="6" 
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="False">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}" 
                                Width="6"
                                Cursor="SizeWE">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                          To="#2196F3" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Rectangle Width="2" 
                                      Height="40" 
                                      Fill="#CCCCCC" 
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RadiusX="1"
                                      RadiusY="1"/>
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- 右侧面板 -->
            <DockPanel x:Name="RightPanel" Grid.Column="2" Margin="5,0,0,0" LastChildFill="True">
                <!-- ROI列表 - 停靠在顶部 -->
                <hc:Card x:Name="ROIPanel" DockPanel.Dock="Top" Header="ROI列表" Margin="0,0,0,5" Height="120">
                    <ListBox ItemsSource="{Binding RoiEditorViewModel.ROIs}"
                            SelectedItem="{Binding RoiEditorViewModel.SelectedROI}"
                            BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ROIName}" FontWeight="Bold" Margin="0,0,5,0"/>
                                    <TextBlock Text="[" Opacity="0.5"/>
                                    <TextBlock Text="{Binding ShapeType}" Opacity="0.5"/>
                                    <TextBlock Text="]" Opacity="0.5"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </hc:Card>

                <!-- 分隔条: ROI列表和SOP模块之间 -->
                <GridSplitter x:Name="ROISplitter" DockPanel.Dock="Top" 
                              Height="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Background="Transparent"
                              ShowsPreview="False">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="{TemplateBinding Background}" 
                                    Height="6"
                                    Cursor="SizeNS">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                              To="#2196F3" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Rectangle Width="40" 
                                          Height="2" 
                                          Fill="#CCCCCC" 
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RadiusX="1"
                                          RadiusY="1"/>
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- SOP流程显示 - 填充剩余空间 -->
                <views:SOPModuleView x:Name="SOPModule" Margin="0,0,0,5"/>


            </DockPanel>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="4" Height="30">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="帧率: " Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBlock FontWeight="Bold" VerticalAlignment="Center" Width="50">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:F1}">
                                <Binding Path="Fps" />
                            </MultiBinding>
                        </TextBlock.Text>
                        <TextBlock.Visibility>
                            <Binding Path="IsVideoPlaying" Converter="{StaticResource Boolean2VisibilityConverter}"/>
                        </TextBlock.Visibility>
                    </TextBlock>
                    <TextBlock FontWeight="Bold" VerticalAlignment="Center" Width="50">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:F1}">
                                <Binding Path="InferenceFps" />
                            </MultiBinding>
                        </TextBlock.Text>
                        <TextBlock.Visibility>
                            <Binding Path="IsRealTimeDetecting" Converter="{StaticResource Boolean2VisibilityConverter}"/>
                        </TextBlock.Visibility>
                    </TextBlock>
                    <TextBlock Text=" FPS" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="就绪" Opacity="0.5" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
