<Window x:Class="VisionInspection.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VisionInspection.UI"
        xmlns:controls="clr-namespace:VisionInspection.UI.Controls"
        xmlns:viewModels="clr-namespace:VisionInspection.UI.ViewModels"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="视觉检测系统" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>
    <Grid Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2196F3" Height="50">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="视觉检测系统" 
                          Foreground="White" FontSize="20" FontWeight="Bold"
                          VerticalAlignment="Center" Margin="20,0" />
            </Grid>
        </Border>

        <!-- 工具栏 -->
        <ToolBarTray Grid.Row="1" Background="White" Margin="0,5">
            <ToolBar Header="图像操作" Band="0" BandIndex="0">
                <Button Content="📁 加载图像" Command="{Binding LoadImageCommand}"
                        Style="{StaticResource ButtonPrimary}" Margin="2"/>
                <Separator/>
                <Button Content="💾 保存ROI" Command="{Binding SaveROIsCommand}" Margin="2"/>
                <Button Content="🗑️ 清空ROI" Command="{Binding ClearROIsCommand}" Margin="2"/>
            </ToolBar>

            <ToolBar Header="ROI工具" Band="0" BandIndex="1">
                <ToggleButton Content="✏️ 创建ROI" 
                             IsChecked="{Binding RoiEditorViewModel.IsCreatingROI}"
                             Style="{StaticResource ToggleButtonPrimary}" Margin="2"/>
                <Separator/>
                <TextBlock Text="形状:" VerticalAlignment="Center" Margin="5,0"/>
                <ComboBox Text="{Binding RoiEditorViewModel.CurrentShapeTypeString}" 
                         Width="100" VerticalAlignment="Center" Margin="2"
                         IsEditable="False" IsReadOnly="True">
                    <ComboBoxItem Content="Rectangle"/>
                    <ComboBoxItem Content="Circle"/>
                </ComboBox>
            </ToolBar>

            <ToolBar Header="SOP检测" Band="0" BandIndex="2" HorizontalAlignment="Right">
                <Button Content="⚙️ 初始化SOP" Command="{Binding InitializeSOPModuleCommand}"
                        Style="{StaticResource ButtonInfo}" Margin="2"/>
                <Button Content="▶️ 运行检测" Command="{Binding RunSOPDetectionCommand}"
                        Style="{StaticResource ButtonSuccess}" Margin="2"/>
            </ToolBar>
        </ToolBarTray>

        <!-- 主内容区 -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- 图像显示区 -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Background="#333"
                    CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <controls:ROIEditorControl 
                        ViewModel="{Binding RoiEditorViewModel}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>
                    
                    <!-- 提示信息 -->
                    <TextBlock Text="点击'加载图像'按钮选择图片" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="White" FontSize="16"
                              Visibility="{Binding RoiEditorViewModel.CurrentImage, Converter={StaticResource Object2VisibilityReConverter}}"/>
                </Grid>
            </Border>

            <!-- 右侧面板 -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <!-- ROI列表 -->
                <hc:Card Header="ROI列表" Margin="0,0,0,10">
                    <ListBox ItemsSource="{Binding RoiEditorViewModel.ROIs}" 
                            SelectedItem="{Binding RoiEditorViewModel.SelectedROI}"
                            Height="200" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ROIName}" FontWeight="Bold" Margin="0,0,5,0"/>
                                    <TextBlock Text="[" Opacity="0.5"/>
                                    <TextBlock Text="{Binding ShapeType}" Opacity="0.5"/>
                                    <TextBlock Text="]" Opacity="0.5"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </hc:Card>

                <!-- SOP状态 -->
                <hc:Card Header="SOP状态">
                    <StackPanel>
                        <TextBlock Text="{Binding SopStatus}" 
                                  Foreground="#2196F3"
                                  FontSize="14" Margin="0,5" TextWrapping="Wrap"/>
                        <ProgressBar Value="{Binding CurrentStep}" 
                                    Maximum="{Binding TotalSteps}"
                                    Height="20" Margin="0,10"/>
                        <TextBlock HorizontalAlignment="Center">
                            <Run Text="{Binding CurrentStep}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding TotalSteps}"/>
                        </TextBlock>
                    </StackPanel>
                </hc:Card>
            </StackPanel>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="3" Height="30">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="就绪" Opacity="0.5"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
