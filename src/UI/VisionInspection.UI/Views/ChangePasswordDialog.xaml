<Window x:Class="VisionInspection.UI.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改密码" 
        Height="350" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <TextBlock Text="🔐 修改密码"
                  FontSize="18"
                  FontWeight="Bold"
                  Margin="0,0,0,20"/>
        
        <!-- 表单 -->
        <StackPanel Grid.Row="1">
            <!-- 原密码 -->
            <TextBlock Text="原密码 *" 
                      FontSize="12"
                      Foreground="Gray"
                      Margin="0,0,0,5"/>
            <PasswordBox x:Name="OldPasswordBox"
                        Height="35"
                        FontSize="14"
                        Padding="10,5"
                        VerticalContentAlignment="Center"/>
            
            <!-- 新密码 -->
            <TextBlock Text="新密码 *" 
                      FontSize="12"
                      Foreground="Gray"
                      Margin="0,15,0,5"/>
            <PasswordBox x:Name="NewPasswordBox"
                        Height="35"
                        FontSize="14"
                        Padding="10,5"
                        VerticalContentAlignment="Center"/>
            
            <!-- 确认新密码 -->
            <TextBlock Text="确认新密码 *" 
                      FontSize="12"
                      Foreground="Gray"
                      Margin="0,15,0,5"/>
            <PasswordBox x:Name="ConfirmPasswordBox"
                        Height="35"
                        FontSize="14"
                        Padding="10,5"
                        VerticalContentAlignment="Center"/>
        </StackPanel>
        
        <!-- 按钮 -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="保存"
                   Padding="25,10"
                   Margin="0,0,10,0"
                   Background="#4CAF50"
                   Foreground="White"
                   BorderThickness="0"
                   Click="SaveButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45A049"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="取消"
                   Padding="25,10"
                   Background="#9E9E9E"
                   Foreground="White"
                   BorderThickness="0"
                   Click="CancelButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#757575"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
