<Window x:Class="VisionInspection.UI.Views.ModelSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="选择模型" Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🧠" FontSize="24" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="选择模型" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="请选择要加载的YOLO模型" FontSize="12" Foreground="#95A5A6" Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 模型列表 -->
        <Border Grid.Row="1" Background="White" Margin="20" CornerRadius="8" Padding="15">
            <DataGrid x:Name="ModelsDataGrid" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      MouseDoubleClick="ModelsDataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="模型名称" Binding="{Binding Name}" Width="150"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="100"/>
                    <DataGridTextColumn Header="输入尺寸" Binding="{Binding InputSize}" Width="80"/>
                    <DataGridTextColumn Header="类别数" Binding="{Binding Classes.Count}" Width="80"/>
                    <DataGridCheckBoxColumn Header="GPU" Binding="{Binding UseGpu}" Width="60"/>
                    <DataGridTextColumn Header="置信度" Binding="{Binding ConfidenceThreshold, StringFormat={}{0:F2}}" Width="80"/>
                    <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="WordEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 按钮 -->
        <Border Grid.Row="2" Background="White" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton" 
                        Content="🔄 刷新" 
                        Width="100" 
                        Margin="0,0,10,0"
                        Click="RefreshButton_Click"/>
                <Button x:Name="SelectButton" 
                        Content="✓ 选择" 
                        Width="100" 
                        Margin="0,0,10,0"
                        Background="#27AE60"
                        Foreground="White"
                        Click="SelectButton_Click"/>
                <Button x:Name="CancelButton" 
                        Content="✕ 取消" 
                        Width="100"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
