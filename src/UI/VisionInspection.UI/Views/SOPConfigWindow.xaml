<Window x:Class="VisionInspection.UI.Views.SOPConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VisionInspection.UI.Views"
        mc:Ignorable="d"
        Title="SOP流程配置" Height="900" Width="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="⚙️" FontSize="24" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="SOP流程配置" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="配置检测流程步骤和参数" FontSize="12" Foreground="#999" Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                    <Button x:Name="LoadButton" Content="📂 加载配置" Padding="15,7" Click="LoadButton_Click"/>
                    <TextBlock x:Name="StepTextBlock" Text="步骤 1" VerticalAlignment="Center" Margin="5,0,5,0" Foreground="#666"/>
                    <Button x:Name="SaveButton" Content="💾 保存配置" Margin="5,0" Padding="15,7" Background="#1890FF" Foreground="White" Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 全局配置栏 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="15,10" Margin="15,15,15,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 统一检测模式说明 -->
                <TextBlock Grid.Column="0" Text="检测模式:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="统一检测（物体检测 + 手部检测）" VerticalAlignment="Center" Foreground="#666"/>

                <!-- 手部检测开关 -->
                <CheckBox x:Name="EnableHandPoseCheckBox" Grid.Column="2" Content="启用手部检测" VerticalAlignment="Center" Margin="20,0,10,0" Checked="EnableHandPoseCheckBox_Checked" Unchecked="EnableHandPoseCheckBox_Unchecked" IsChecked="True"/>

                <!-- 最大手数 -->
                <TextBlock Grid.Column="3" Text="最大手数:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <ComboBox x:Name="MaxHandsComboBox" Grid.Column="4" Height="28" Padding="8,0" VerticalContentAlignment="Center" IsEnabled="False">
                    <ComboBoxItem Content="1" IsSelected="True"/>
                    <ComboBoxItem Content="2"/>
                </ComboBox>

                <!-- GPU加速 -->
                <CheckBox x:Name="UseGpuCheckBox" Grid.Column="5" Content="GPU加速" VerticalAlignment="Center" Margin="20,0,0,0" IsChecked="True"/>
                
                <!-- 高级参数按钮 -->
                <Button x:Name="AdvancedParamsButton" Grid.Column="6" Content="⚙️ 高级参数" HorizontalAlignment="Right" Padding="10,5" Click="AdvancedParamsButton_Click"/>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="2" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- 步骤列表 -->
            <Border Grid.Column="0" Background="White" CornerRadius="6" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 列表标题 -->
                    <Border Grid.Row="0" Background="#FAFAFA" Padding="15,12" CornerRadius="6,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="序号" FontWeight="Bold" Foreground="#666"/>
                            <TextBlock Grid.Column="1" Text="步骤名称" FontWeight="Bold" Foreground="#666" Margin="10,0"/>
                            <TextBlock Grid.Column="2" Text="检测类型" FontWeight="Bold" Foreground="#666"/>
                            <TextBlock Grid.Column="3" Text="操作" FontWeight="Bold" Foreground="#666" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 步骤列表 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="StepsListPanel" Margin="10"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 步骤编辑区 -->
            <Border Grid.Column="1" Background="White" CornerRadius="6" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="编辑步骤" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

                    <StackPanel Grid.Row="1">
                        <!-- 步骤名称 -->
                        <TextBlock Text="步骤名称" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox x:Name="StepNameTextBox" Height="32" Padding="10,0" VerticalContentAlignment="Center"/>

                        <!-- 检测类型 -->
                        <TextBlock Text="检测类型" FontSize="12" Foreground="#666" Margin="0,10,0,5"/>
                        <ComboBox x:Name="DetectionTypeComboBox" Height="32" Padding="10,0" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="物体检测"/>
                            <ComboBoxItem Content="OCR识别"/>
                            <ComboBoxItem Content="二维码识别"/>
                            <ComboBoxItem Content="尺寸测量"/>
                            <ComboBoxItem Content="颜色检测"/>
                            <ComboBoxItem Content="自定义脚本"/>
                        </ComboBox>

                        <!-- 模型选择 -->
                        <TextBlock Text="使用模型" FontSize="12" Foreground="#666" Margin="0,10,0,5"/>
                        <ComboBox x:Name="ModelComboBox" Height="32" Padding="10,0" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="默认YOLOv8模型"/>
                            <ComboBoxItem Content="车牌识别模型"/>
                            <ComboBoxItem Content="人脸检测模型"/>
                            <ComboBoxItem Content="自定义模型..."/>
                        </ComboBox>

                        <!-- 描述 -->
                        <TextBlock Text="步骤描述" FontSize="12" Foreground="#666" Margin="0,10,0,5"/>
                        <TextBox x:Name="StepDescriptionTextBox" Height="60" Padding="10" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                        <!-- 图标选择 -->
                        <TextBlock Text="步骤图标" FontSize="12" Foreground="#666" Margin="0,10,0,5"/>
                        <WrapPanel x:Name="IconPanel">
                            <Button Content="🔍" Width="36" Height="36" Margin="2" Click="IconButton_Click"/>
                            <Button Content="📄" Width="36" Height="36" Margin="2" Click="IconButton_Click"/>
                            <Button Content="✓" Width="36" Height="36" Margin="2" Click="IconButton_Click"/>
                            <Button Content="🔌" Width="36" Height="36" Margin="2" Click="IconButton_Click"/>
                            <Button Content="📷" Width="36" Height="36" Margin="2" Click="IconButton_Click"/>
                            <Button Content="🔧" Width="36" Height="36" Margin="2" Click="IconButton_Click"/>
                            <Button Content="📏" Width="36" Height="36" Margin="2" Click="IconButton_Click"/>
                            <Button Content="🎨" Width="36" Height="36" Margin="2" Click="IconButton_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- 按钮 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button x:Name="ClearButton" Content="🗑️ 清空" Margin="5,0" Padding="15,7" Click="ClearButton_Click"/>
                        <Button x:Name="AddStepButton" Content="➕ 添加步骤" Margin="5,0" Padding="15,7" Background="#52C41A" Foreground="White" Click="AddStepButton_Click"/>
                        <Button x:Name="UpdateStepButton" Content="💾 更新步骤" Margin="5,0" Padding="15,7" Background="#1890FF" Foreground="White" Click="UpdateStepButton_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ClearAllButton" Content="🗑️ 清空全部" Margin="5,0" Padding="20,7" Click="ClearAllButton_Click"/>
                <Button x:Name="CancelButton" Content="❌ 取消" Margin="5,0" Padding="20,7" Click="CancelButton_Click"/>
                <Button x:Name="ConfirmButton" Content="✓ 确定" Margin="5,0" Padding="20,7" Background="#1890FF" Foreground="White" Click="ConfirmButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
