<Window x:Class="VisionInspection.UI.Views.HandDetectionParamsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Icon="/Assets/AppIcon.ico"
        Title="手部检测高级参数配置" Height="800" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙️" FontSize="24" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="手部检测高级参数" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="调整检测性能和稳定性参数" FontSize="12" Foreground="#999" Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 参数配置区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
            <StackPanel>
                <!-- 参数1：推理间隔 -->
                <Border Background="White" CornerRadius="6" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="推理间隔（跳帧）" FontSize="14" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" x:Name="InferenceIntervalValue" Text="2" FontSize="14" FontWeight="Bold" Foreground="#1890FF"/>
                        </Grid>
                        <Slider x:Name="InferenceIntervalSlider" Minimum="1" Maximum="5" Value="2" 
                                Margin="0,10" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="InferenceIntervalSlider_ValueChanged"/>
                        <TextBlock Text="每N帧进行一次模型推理。值越大画面越流畅，但检测延迟增加。" 
                                   FontSize="12" Foreground="#666" TextWrapping="Wrap"/>
                        <TextBlock Text="推荐值：1-2（实时性要求高）| 3-5（性能优先）" 
                                   FontSize="11" Foreground="#999" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 参数2：平滑窗口 -->
                <Border Background="White" CornerRadius="6" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="平滑窗口大小" FontSize="14" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" x:Name="SmoothWindowValue" Text="5" FontSize="14" FontWeight="Bold" Foreground="#1890FF"/>
                        </Grid>
                        <Slider x:Name="SmoothWindowSlider" Minimum="3" Maximum="15" Value="5" 
                                Margin="0,10" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="SmoothWindowSlider_ValueChanged"/>
                        <TextBlock Text="用于时序平滑的历史帧数。值越大抖动越少，但响应变慢。" 
                                   FontSize="12" Foreground="#666" TextWrapping="Wrap"/>
                        <TextBlock Text="推荐值：3-5（响应优先）| 7-10（平滑优先）" 
                                   FontSize="11" Foreground="#999" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 参数3：平滑系数 -->
                <Border Background="White" CornerRadius="6" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="平滑系数（Alpha）" FontSize="14" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" x:Name="SmoothAlphaValue" Text="0.70" FontSize="14" FontWeight="Bold" Foreground="#1890FF"/>
                        </Grid>
                        <Slider x:Name="SmoothAlphaSlider" Minimum="0.3" Maximum="0.95" Value="0.7" 
                                Margin="0,10" TickFrequency="0.05"
                                ValueChanged="SmoothAlphaSlider_ValueChanged"/>
                        <TextBlock Text="指数平滑系数，控制历史值与当前值的权重。值越小越平滑，值越大响应越快。" 
                                   FontSize="12" Foreground="#666" TextWrapping="Wrap"/>
                        <TextBlock Text="推荐值：0.5-0.6（强平滑）| 0.7-0.8（平衡）| 0.9+（快响应）" 
                                   FontSize="11" Foreground="#999" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 参数4：骨架置信度阈值 -->
                <Border Background="White" CornerRadius="6" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="骨架置信度阈值" FontSize="14" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" x:Name="SkeletonThresholdValue" Text="0.30" FontSize="14" FontWeight="Bold" Foreground="#1890FF"/>
                        </Grid>
                        <Slider x:Name="SkeletonThresholdSlider" Minimum="0.1" Maximum="0.8" Value="0.3"
                                Margin="0,10" TickFrequency="0.05"
                                ValueChanged="SkeletonThresholdSlider_ValueChanged"/>
                        <TextBlock Text="绘制骨架和关键点的最小置信度。低于此值的关键点不显示，减少闪烁。"
                                   FontSize="12" Foreground="#666" TextWrapping="Wrap"/>
                        <TextBlock Text="推荐值：0.2（完整显示）| 0.3（平衡）| 0.5+（稳定优先）"
                                   FontSize="11" Foreground="#999" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 参数5：检测置信度 -->
                <Border Background="White" CornerRadius="6" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="检测置信度阈值" FontSize="14" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" x:Name="DetectionConfidenceValue" Text="0.08" FontSize="14" FontWeight="Bold" Foreground="#E67E22"/>
                        </Grid>
                        <Slider x:Name="DetectionConfidenceSlider" Minimum="0.02" Maximum="0.30" Value="0.08"
                                Margin="0,10" TickFrequency="0.02"
                                ValueChanged="DetectionConfidenceSlider_ValueChanged"/>
                        <TextBlock Text="模型推理置信度下限。握拳/握物时需设低，但过低会增加误检"
                                   FontSize="12" Foreground="#666" TextWrapping="Wrap"/>
                        <TextBlock Text="推荐值：0.05（宽松）| 0.08（默认）| 0.15（严格）"
                                   FontSize="11" Foreground="#999" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 参数6：最小检测尺寸 -->
                <Border Background="White" CornerRadius="6" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最小检测尺寸比例" FontSize="14" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" x:Name="MinBoxAreaValue" Text="0.0005" FontSize="14" FontWeight="Bold" Foreground="#E67E22"/>
                        </Grid>
                        <Slider x:Name="MinBoxAreaSlider" Minimum="0.0001" Maximum="0.005" Value="0.0005"
                                Margin="0,10" TickFrequency="0.0002"
                                ValueChanged="MinBoxAreaSlider_ValueChanged"/>
                        <TextBlock Text="检测框面积 / 画面面积的最小值。握拳的检测框更小，降低此值可检测到小拳头"
                                   FontSize="12" Foreground="#666" TextWrapping="Wrap"/>
                        <TextBlock Text="默认 0.0005（640x480≈153px≈12×12），值越小允许越小框"
                                   FontSize="11" Foreground="#999" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 面部过滤 -->
                <Border Background="White" CornerRadius="6" Padding="20" Margin="0,0,0,15">
                    <Border.Resources>
                        <Style TargetType="CheckBox">
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </Border.Resources>
                    <StackPanel>
                        <CheckBox x:Name="EnableFaceFilterCheckBox" Content="启用面部过滤"
                                  Checked="FaceFilterCheckBox_Changed" Unchecked="FaceFilterCheckBox_Changed"/>
                        <TextBlock Text="过滤画面上方形状像脸/下巴/嘴巴的检测框，减少误检"
                                   FontSize="12" Foreground="#666" Margin="20,5,0,0"/>
                        <Grid Margin="20,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="过滤高度比例" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="FaceFilterUpperValue" Text="0.38" FontSize="14" FontWeight="Bold" Foreground="#1890FF"/>
                        </Grid>
                        <Slider x:Name="FaceFilterUpperSlider" Minimum="0.20" Maximum="0.55" Value="0.38"
                                Margin="20,5,0,5" TickFrequency="0.02"
                                ValueChanged="FaceFilterUpperSlider_ValueChanged"/>
                        <TextBlock Text="中心Y在此比例以上的检测框视为'画面上方'。值越大过滤越激进"
                                   FontSize="11" Foreground="#999" Margin="20,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 手部结构验证 -->
                <Border Background="White" CornerRadius="6" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <CheckBox x:Name="EnableHandStructureCheckBox" Content="启用手部结构验证"
                                  Checked="HandStructureCheckBox_Changed" Unchecked="HandStructureCheckBox_Changed"/>
                        <TextBlock Text="验证手腕到指尖的距离，排除脸部关键点聚集导致的误检。手指合拢/握拳时若被误过滤可关闭"
                                   FontSize="12" Foreground="#666" Margin="20,5,0,0" TextWrapping="Wrap"/>
                        <Grid Margin="20,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="手腕距离阈值" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="WristTipRatioValue" Text="0.18" FontSize="14" FontWeight="Bold" Foreground="#1890FF"/>
                        </Grid>
                        <Slider x:Name="WristTipRatioSlider" Minimum="0.08" Maximum="0.35" Value="0.18"
                                Margin="20,5,0,5" TickFrequency="0.02"
                                ValueChanged="WristTipRatioSlider_ValueChanged"/>
                        <TextBlock Text="手腕到指尖距离 / 检测框对角线。值越小越宽松，握拳容易通过；值越大过滤越严格"
                                   FontSize="11" Foreground="#999" Margin="20,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 快速预设按钮 -->
                <Border Background="White" CornerRadius="6" Padding="20">
                    <StackPanel>
                        <TextBlock Text="快速预设" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Button Content="🚀 实时优先" Margin="0,0,10,5" Padding="15,8" Click="PresetRealtime_Click" Height="40"/>
                            <Button Content="⚖️ 平衡模式" Margin="0,0,10,5" Padding="15,8" Click="PresetBalanced_Click" Height="40"/>
                            <Button Content="🎯 稳定优先" Margin="0,0,10,5" Padding="15,8" Click="PresetStable_Click" Height="40"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,1,0,0" Padding="10,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="❌ 取消" Margin="5,0" Padding="20,10" Click="CancelButton_Click" Height="40"/>
                <Button Content="✓ 确定" Margin="5,0" Padding="20,10" Background="#1890FF" Foreground="White" Click="ConfirmButton_Click" Height="40"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>