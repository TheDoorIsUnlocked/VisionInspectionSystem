<Window x:Class="VisionInspection.UI.Views.CameraConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VisionInspection.UI.Views"
        mc:Ignorable="d"
        Icon="/Assets/AppIcon.ico"
        Title="相机配置" Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Closing="Window_Closing">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📷" FontSize="24" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="相机配置" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="配置工业相机连接和参数" FontSize="12" Foreground="#999" Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Background="#52C41A" CornerRadius="4" Padding="10,5" Margin="0,0,10,0"
                            Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}" Height="28">
                        <TextBlock Text="● 已连接" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#FF4D4F" CornerRadius="4" Padding="10,5"
                            Visibility="{Binding IsConnected, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Height="28">
                        <TextBlock Text="● 未连接" Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：设备列表和连接 -->
            <Border Grid.Column="0" Background="White" CornerRadius="6" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 设备列表 -->
                    <Border Grid.Row="0" Background="#FAFAFA" Padding="15" CornerRadius="6,6,0,0">
                        <StackPanel>
                            <TextBlock Text="相机设备" FontWeight="Bold" Margin="0,0,0,10"/>
                            <!-- 相机类型选择 -->
                            <ComboBox x:Name="CameraTypeComboBox" Margin="0,0,0,10" SelectedIndex="0" SelectionChanged="CameraTypeComboBox_SelectionChanged">
                                <ComboBoxItem Content="🎥 笔记本摄像头"/>
                                <ComboBoxItem Content="📷 GigE相机"/>
                                <ComboBoxItem Content="🌐 网络相机 (ONVIF)"/>
                            </ComboBox>
                            <!-- 网络相机 RTSP 地址（ONVIF 类型时显示，可手动填写/修改） -->
                            <StackPanel x:Name="RtspPanel" Margin="0,0,0,10" Visibility="Collapsed">
                                <TextBlock Text="RTSP 地址" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                                <TextBox x:Name="RtspUrlTextBox" Padding="4,3" BorderBrush="#B0BEC5" BorderThickness="1"
                                         TextChanged="RtspUrlTextBox_TextChanged"
                                         ToolTip="支持 rtsp://user:pass@ip:554/... 格式；发现相机后自动填充，也可手动输入"/>
                            </StackPanel>
                            <Button x:Name="EnumInterfaceButton" Content="🔍 搜索相机" Padding="15,2" Margin="0,0,0,10"
                                    Click="EnumInterfaceButton_Click"/>
                            <Button x:Name="EnumDeviceButton" Content="🔄 刷新列表" Padding="15,2" Margin="0,0,0,10"
                                    Click="EnumDeviceButton_Click" IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- 设备列表标题 -->
                    <Border Grid.Row="1" Background="#FAFAFA" Padding="15" BorderBrush="#E8E8E8" BorderThickness="0,1">
                        <TextBlock Text="可用相机" FontWeight="Bold"/>
                    </Border>

                    <!-- 设备列表 -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DeviceListPanel" Margin="10"/>
                    </ScrollViewer>

                    <!-- 连接按钮 -->
                    <Border Grid.Row="3" Padding="15" BorderBrush="#E8E8E8" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Button x:Name="ConnectButton" Content="🔗 连接相机" Padding="15,1" Background="#1890FF" Foreground="White"
                                    Click="ConnectButton_Click" IsEnabled="False"/>
                            <Button x:Name="DisconnectButton" Content="❌ 断开连接" Padding="15,1" Margin="0,10,0,0"
                                    Click="DisconnectButton_Click" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧：参数配置和预览 -->
            <Border Grid.Column="1" Background="White" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 参数配置 -->
                    <Border Grid.Row="0" Background="#FAFAFA" Padding="20" CornerRadius="6,6,0,0">
                        <TextBlock Text="相机参数" FontSize="16" FontWeight="Bold"/>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="20">
                        <!-- 曝光时间 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="曝光时间" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="ExposureSlider" Minimum="100" Maximum="100000" Value="10000"
                                    VerticalAlignment="Center" Margin="10,0" IsEnabled="False"
                                    ValueChanged="ExposureSlider_ValueChanged"/>
                            <TextBlock Grid.Column="2" x:Name="ExposureValueText" Text="10000 μs" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- 增益 -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="增益" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="GainSlider" Minimum="0" Maximum="20" Value="0"
                                    VerticalAlignment="Center" Margin="10,0" IsEnabled="False"
                                    ValueChanged="GainSlider_ValueChanged"/>
                            <TextBlock Grid.Column="2" x:Name="GainValueText" Text="0 dB" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- 采集控制 -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="StartGrabButton" Content="▶️ 开始采集" Padding="20,1" Margin="0,0,10,0"
                                    Background="#52C41A" Foreground="White" Click="StartGrabButton_Click" IsEnabled="False"/>
                            <Button x:Name="StopGrabButton" Content="⏹️ 停止采集" Padding="20,1"
                                    Click="StopGrabButton_Click" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 图像预览 -->
                    <Border Grid.Row="2" Margin="20" Background="#333" CornerRadius="4" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform"/>
                            <TextBlock x:Name="NoImageText" Text='点击"开始采集"按钮预览图像' 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="White" FontSize="14"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="2" Height="32">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" Opacity="0.7"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SaveConfigButton" Content="💾 保存配置" Padding="15,2" Margin="0,0,10,0"
                            Click="SaveConfigButton_Click" IsEnabled="False"/>
                    <Button x:Name="CloseButton" Content="❌ 关闭" Padding="15,2" Click="CloseButton_Click"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
