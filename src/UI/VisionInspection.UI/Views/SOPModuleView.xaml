<UserControl x:Class="VisionInspection.UI.Views.SOPModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VisionInspection.UI.Views"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="400">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题和控制按钮 -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="1,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📋" FontSize="20" Margin="0,0,0,0"/>
                    <TextBlock Text="SOP检测模块" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ConfigButton" Content="⚙️ 配置" Margin="5,0" Padding="10,5"
                            Click="ConfigButton_Click"/>
                    <Button x:Name="RunButton" Content="▶️ 运行" Margin="5,0" Padding="10,5"
                            Background="#52C41A" Foreground="White"
                            Click="RunButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 状态概览 -->
        <Border Grid.Row="1" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="检测状态" FontSize="12" Foreground="#999" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatusTextBlock" Text="未初始化" FontSize="14" FontWeight="Bold" 
                              Foreground="#999" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="当前步骤" FontSize="12" Foreground="#999" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StepTextBlock" Text="0/0" FontSize="14" FontWeight="Bold" 
                              Foreground="#1890FF" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="耗时" FontSize="12" Foreground="#999" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TimerTextBlock" Text="00:00" FontSize="14" FontWeight="Bold" 
                              Foreground="#FA8C16" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="检测结果" FontSize="12" Foreground="#999" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ResultTextBlock" Text="--" FontSize="14" FontWeight="Bold" 
                              Foreground="#999" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 检测流程列表 - 垂直列表布局 -->
        <Border Grid.Row="2" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                <StackPanel x:Name="StepsPanel" Orientation="Vertical" Margin="5">
                    <!-- 步骤项将通过代码动态添加 -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 分隔条1: 步骤列表和时间轴之间 -->
        <GridSplitter Grid.Row="3" 
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="False">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{TemplateBinding Background}" 
                            Cursor="SizeNS">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#2196F3" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle Width="40" 
                                   Height="2" 
                                   Fill="#CCCCCC" 
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RadiusX="1"
                                   RadiusY="1"/>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- 步骤时间轴 -->
        <Border Grid.Row="4" BorderBrush="#E8E8E8" BorderThickness="0,1,0,1" Background="#FAFAFA">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#F0F0F0" Padding="10,5">
                    <TextBlock Text="⏱️ 步骤时间轴" FontSize="12" Foreground="#666" FontWeight="Medium"/>
                </Border>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TimelinePanel" Orientation="Horizontal" Margin="10,5">
                        <!-- 时间轴项将通过代码动态添加 -->
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 分隔条2: 时间轴和日志之间 -->
        <GridSplitter Grid.Row="5" 
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="False">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{TemplateBinding Background}" 
                            Cursor="SizeNS">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#2196F3" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle Width="40" 
                                   Height="2" 
                                   Fill="#CCCCCC" 
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RadiusX="1"
                                   RadiusY="1"/>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- 日志输出 -->
        <Border Grid.Row="6" BorderBrush="#E8E8E8" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#FAFAFA" Padding="10,5">
                    <TextBlock Text="📝 运行日志" FontSize="12" Foreground="#666" FontWeight="Medium"/>
                </Border>
                <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" 
                        VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                        BorderThickness="0" Background="Transparent" Padding="10,5"
                        FontFamily="Consolas" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
