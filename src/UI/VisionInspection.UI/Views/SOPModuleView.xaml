<UserControl x:Class="VisionInspection.UI.Views.SOPModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VisionInspection.UI.Views"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="400">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部操作工具栏 + 标题/配方栏 -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="1,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部操作工具栏：标定 / 配置 / 运行 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,5,5">
                    <Button x:Name="RegionButton" Content="🎯 标定区域" Margin="5,0" Padding="10,5"
                            Click="RegionButton_Click" Height="30"/>
                    <Button x:Name="ConfigButton" Content="⚙️ 配置" Margin="5,0" Padding="10,5"
                            Click="ConfigButton_Click" Height="30"/>
                    <Button x:Name="RunButton" Content="▶️ 运行" Margin="5,0" Padding="10,5"
                            Background="#52C41A" Foreground="White"
                            Click="RunButton_Click" Height="30"/>
                </StackPanel>

                <!-- 标题行：模块名称 + 产品配方 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="📋" FontSize="20" Margin="0,0,0,0"/>
                        <TextBlock Text="SOP检测模块" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                                x:Name="RecipePanel">
                        <StackPanel.ContextMenu>
                            <ContextMenu x:Name="RecipeActionsContextMenu">
                                <MenuItem Header="➕ 新建" Click="NewRecipeButton_Click"
                                          ToolTip="基于模板或空白新建一个产品配方"/>
                                <MenuItem x:Name="RenameRecipeMenuItem" Header="✏️ 重命名" Click="RenameRecipeButton_Click"
                                          ToolTip="修改当前配方的产品名称" IsEnabled="False"/>
                                <MenuItem x:Name="DeleteRecipeMenuItem" Header="🗑 删除" Click="DeleteRecipeButton_Click"
                                          ToolTip="删除当前选中的配方文件（不可恢复）" IsEnabled="False"/>
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <TextBlock Text="📦 产品配方" FontSize="12" Foreground="#666" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="RecipeComboBox" Width="200" Height="30" VerticalAlignment="Center"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="FullPath"
                                  SelectionChanged="RecipeComboBox_SelectionChanged"/>
                        <!-- 配方管理操作合并为单个下拉菜单，避免标题栏溢出 -->
                        <Button x:Name="RecipeActionsButton" Content="⋮" FontSize="16" Padding="6,0" Height="30" Width="30"
                                Margin="6,0,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip="配方管理：新建 / 重命名 / 删除"
                                Click="RecipeActionsButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 状态概览 -->
        <Border Grid.Row="1" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="检测状态" FontSize="12" Foreground="#999" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatusTextBlock" Text="未初始化" FontSize="14" FontWeight="Bold" 
                              Foreground="#999" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="当前步骤" FontSize="12" Foreground="#999" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StepTextBlock" Text="0/0" FontSize="14" FontWeight="Bold" 
                              Foreground="#1890FF" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="耗时" FontSize="12" Foreground="#999" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TimerTextBlock" Text="00:00" FontSize="14" FontWeight="Bold" 
                              Foreground="#FA8C16" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="检测结果" FontSize="12" Foreground="#999" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ResultTextBlock" Text="--" FontSize="14" FontWeight="Bold" 
                              Foreground="#999" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 检测流程列表 - 垂直列表布局 -->
        <Border Grid.Row="2" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                <StackPanel x:Name="StepsPanel" Orientation="Vertical" Margin="5">
                    <!-- 步骤项将通过代码动态添加 -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 分隔条1: 步骤列表和时间轴之间 -->
        <GridSplitter Grid.Row="3" 
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="False">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{TemplateBinding Background}" 
                            Cursor="SizeNS">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#2196F3" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle Width="40" 
                                   Height="2" 
                                   Fill="#CCCCCC" 
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RadiusX="1"
                                   RadiusY="1"/>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- 步骤时间轴 -->
        <Border Grid.Row="4" BorderBrush="#E8E8E8" BorderThickness="0,1,0,1" Background="#FAFAFA">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#F0F0F0" Padding="10,5">
                    <TextBlock Text="⏱️ 步骤时间轴" FontSize="12" Foreground="#666" FontWeight="Medium"/>
                </Border>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TimelinePanel" Orientation="Horizontal" Margin="10,5">
                        <!-- 时间轴项将通过代码动态添加 -->
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 分隔条2: 时间轴和日志之间 -->
        <GridSplitter Grid.Row="5" 
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="False">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{TemplateBinding Background}" 
                            Cursor="SizeNS">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#2196F3" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle Width="40" 
                                   Height="2" 
                                   Fill="#CCCCCC" 
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RadiusX="1"
                                   RadiusY="1"/>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- 日志输出 -->
        <Border Grid.Row="6" BorderBrush="#E8E8E8" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#FAFAFA" Padding="10,5">
                    <TextBlock Text="📝 运行日志" FontSize="12" Foreground="#666" FontWeight="Medium"/>
                </Border>
                <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" 
                        VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                        BorderThickness="0" Background="Transparent" Padding="10,5"
                        FontFamily="Consolas" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
