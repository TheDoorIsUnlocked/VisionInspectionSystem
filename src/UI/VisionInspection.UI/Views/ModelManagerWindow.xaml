<Window x:Class="VisionInspection.UI.Views.ModelManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="模型管理" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🧠" FontSize="24" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="模型管理" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="管理YOLO深度学习模型" FontSize="12" Foreground="#95A5A6" Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- 扫描按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="ScanFolderButton" 
                            Content="🔍 扫描模型文件夹" 
                            Padding="15,8"
                            Margin="0,0,10,0"
                            Background="#27AE60"
                            Foreground="White"
                            BorderThickness="0"
                            Click="ScanFolderButton_Click"/>
                    <Button x:Name="AutoImportButton" 
                            Content="📥 自动导入新模型" 
                            Padding="15,8"
                            Background="#E67E22"
                            Foreground="White"
                            BorderThickness="0"
                            Click="AutoImportButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- 模型列表 -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,10,0" Padding="15">
                <DockPanel>
                    <TextBlock Text="模型列表" FontSize="14" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                    
                    <DataGrid x:Name="ModelsDataGrid" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              SelectionChanged="ModelsDataGrid_SelectionChanged"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="100"/>
                            <DataGridTextColumn Header="类别数" Binding="{Binding Classes.Count}" Width="80"/>
                            <DataGridCheckBoxColumn Header="GPU" Binding="{Binding UseGpu}" Width="60"/>
                            <DataGridTextColumn Header="置信度" Binding="{Binding ConfidenceThreshold, StringFormat={}{0:F2}}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- 模型详情/编辑 -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ModelDetailsPanel">
                        <TextBlock Text="模型详情" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="模型名称" Margin="0,0,0,5"/>
                        <TextBox x:Name="ModelNameTextBox" Margin="0,0,0,10"/>

                        <TextBlock Text="描述" Margin="0,0,0,5"/>
                        <TextBox x:Name="ModelDescriptionTextBox" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True"
                                 Height="60"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="模型文件路径" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ModelPathTextBox" Grid.Column="0" IsReadOnly="True"/>
                            <Button x:Name="BrowseButton" 
                                    Content="浏览..." 
                                    Grid.Column="1" 
                                    Margin="5,0,0,0"
                                    Click="BrowseButton_Click"/>
                        </Grid>

                        <TextBlock Text="模型类型" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ModelTypeComboBox" Margin="0,0,0,10">
                            <ComboBoxItem Content="目标检测"/>
                            <ComboBoxItem Content="图像分割"/>
                            <ComboBoxItem Content="图像分类"/>
                            <ComboBoxItem Content="姿态估计"/>
                        </ComboBox>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="输入尺寸" Margin="0,0,0,5"/>
                                <TextBox x:Name="InputSizeTextBox" Text="640"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="GPU设备ID" Margin="0,0,0,5"/>
                                <TextBox x:Name="GpuIdTextBox" Text="0"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="UseGpuCheckBox" 
                                  Content="使用GPU加速" 
                                  IsChecked="True"
                                  Margin="0,0,0,15"/>

                        <TextBlock Text="置信度阈值" Margin="0,0,0,5"/>
                        <Slider x:Name="ConfidenceSlider" 
                                Minimum="0.01" Maximum="1.0" Value="0.5"
                                TickFrequency="0.01"
                                Margin="0,0,0,5"/>
                        <TextBlock x:Name="ConfidenceValueText" 
                                   Text="0.50" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="IoU阈值" Margin="0,0,0,5"/>
                        <Slider x:Name="IouSlider" 
                                Minimum="0.01" Maximum="1.0" Value="0.45"
                                TickFrequency="0.01"
                                Margin="0,0,0,5"/>
                        <TextBlock x:Name="IouValueText" 
                                   Text="0.45" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="类别列表" Margin="0,0,0,5"/>
                        <TextBox x:Name="ClassesTextBox" 
                                 IsReadOnly="True"
                                 Background="#F5F5F5"
                                 Height="80"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,10"/>

                        <!-- 按钮 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="AddButton" 
                                    Content="➕ 添加" 
                                    Width="80" 
                                    Margin="5"
                                    Click="AddButton_Click"/>
                            <Button x:Name="UpdateButton" 
                                    Content="💾 更新" 
                                    Width="80" 
                                    Margin="5"
                                    Click="UpdateButton_Click"/>
                            <Button x:Name="DeleteButton" 
                                    Content="🗑️ 删除" 
                                    Width="80" 
                                    Margin="5"
                                    Click="DeleteButton_Click"/>
                            <Button x:Name="LoadButton" 
                                    Content="📂 加载" 
                                    Width="80" 
                                    Margin="5"
                                    Click="LoadButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="White" Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TestButton" 
                        Content="🧪 测试模型" 
                        Width="120" 
                        Margin="0,0,10,0"
                        Click="TestButton_Click"/>
                <Button x:Name="CloseButton" 
                        Content="❌ 关闭" 
                        Width="100"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
