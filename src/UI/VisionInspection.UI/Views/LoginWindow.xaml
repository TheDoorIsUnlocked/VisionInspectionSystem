<Window x:Class="VisionInspection.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户登录 - 视觉检测系统" 
        Height="480" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F0F2F5">
    <Grid>
        <Border Background="White" 
                CornerRadius="8" 
                Margin="30" 
                Padding="40,35"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" 
                                 BlurRadius="15" 
                                 Opacity="0.2" 
                                 Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <!-- 图标 -->
                <TextBlock Text="🔐" 
                          FontSize="56" 
                          HorizontalAlignment="Center"
                          Margin="0,0,0,15"/>
                
                <!-- 标题 -->
                <TextBlock Text="视觉检测系统" 
                          FontSize="24" 
                          FontWeight="Bold"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,5"/>
                <TextBlock Text="用户登录" 
                          FontSize="14"
                          Foreground="#666"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,30"/>
                
                <!-- 用户名 -->
                <TextBlock Text="用户名" 
                          FontSize="13"
                          Foreground="#333"
                          Margin="0,0,0,8"
                          FontWeight="Medium"/>
                <Border BorderBrush="#D9D9D9" 
                       BorderThickness="1" 
                       CornerRadius="4"
                       Height="40">
                    <TextBox x:Name="UsernameTextBox"
                            FontSize="14"
                            Padding="12,0"
                            VerticalContentAlignment="Center"
                            BorderThickness="0"
                            Background="Transparent"/>
                </Border>
                
                <!-- 密码 -->
                <TextBlock Text="密码" 
                          FontSize="13"
                          Foreground="#333"
                          Margin="0,20,0,8"
                          FontWeight="Medium"/>
                <Border BorderBrush="#D9D9D9" 
                       BorderThickness="1" 
                       CornerRadius="4"
                       Height="40">
                    <PasswordBox x:Name="PasswordBox"
                                FontSize="14"
                                Padding="12,0"
                                VerticalContentAlignment="Center"
                                BorderThickness="0"
                                Background="Transparent"/>
                </Border>
                
                <!-- 记住我 -->
                <CheckBox x:Name="RememberMeCheckBox"
                         Content="记住用户名"
                         Margin="0,18,0,0"
                         Foreground="#666"
                         FontSize="12"/>
                
                <!-- 登录按钮 -->
                <Button x:Name="LoginButton"
                       Content="登 录"
                       Height="42"
                       Margin="0,25,0,0"
                       Background="#1890FF"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="Bold"
                       BorderThickness="0"
                       Cursor="Hand"
                       Click="LoginButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#40A9FF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#096DD9"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#D9D9D9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <!-- 提示信息 -->
                <TextBlock x:Name="MessageTextBlock"
                          Text=""
                          Foreground="#FF4D4F"
                          FontSize="12"
                          TextWrapping="Wrap"
                          TextAlignment="Center"
                          Margin="0,15,0,0"
                          Visibility="Collapsed"/>
                
                <!-- 默认账户提示 -->
                <TextBlock Text="默认账户: admin / admin123"
                          FontSize="11"
                          Foreground="#999"
                          HorizontalAlignment="Center"
                          Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
