<Window x:Class="VisionInspection.UI.Views.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑用户" 
        Height="400" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <TextBlock x:Name="TitleTextBlock"
                  Text="添加用户"
                  FontSize="18"
                  FontWeight="Bold"
                  Margin="0,0,0,20"/>
        
        <!-- 表单 -->
        <StackPanel Grid.Row="1">
            <!-- 用户名 -->
            <TextBlock Text="用户名 *" 
                      FontSize="12"
                      Foreground="Gray"
                      Margin="0,0,0,5"/>
            <TextBox x:Name="UsernameTextBox"
                    Height="35"
                    FontSize="14"
                    Padding="10,5"
                    VerticalContentAlignment="Center"/>
            
            <!-- 显示名称 -->
            <TextBlock Text="显示名称 *" 
                      FontSize="12"
                      Foreground="Gray"
                      Margin="0,15,0,5"/>
            <TextBox x:Name="DisplayNameTextBox"
                    Height="35"
                    FontSize="14"
                    Padding="10,5"
                    VerticalContentAlignment="Center"/>
            
            <!-- 密码（仅添加时显示） -->
            <TextBlock x:Name="PasswordLabel"
                      Text="密码 *" 
                      FontSize="12"
                      Foreground="Gray"
                      Margin="0,15,0,5"/>
            <PasswordBox x:Name="PasswordBox"
                        Height="35"
                        FontSize="14"
                        Padding="10,5"
                        VerticalContentAlignment="Center"/>
            
            <!-- 角色 -->
            <TextBlock Text="角色" 
                      FontSize="12"
                      Foreground="Gray"
                      Margin="0,15,0,5"/>
            <ComboBox x:Name="RoleComboBox"
                     Height="35"
                     FontSize="14"
                     Padding="10,5"
                     VerticalContentAlignment="Center">
                <ComboBoxItem Content="管理员" Tag="2"/>
                <ComboBoxItem Content="操作员" Tag="1"/>
                <ComboBoxItem Content="访客" Tag="0"/>
            </ComboBox>
            
            <!-- 状态 -->
            <CheckBox x:Name="IsActiveCheckBox"
                     Content="启用账户"
                     IsChecked="True"
                     Margin="0,15,0,0"/>
        </StackPanel>
        
        <!-- 按钮 -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="保存"
                   Padding="25,10"
                   Margin="0,0,10,0"
                   Background="#4CAF50"
                   Foreground="White"
                   BorderThickness="0"
                   Click="SaveButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45A049"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="取消"
                   Padding="25,10"
                   Background="#9E9E9E"
                   Foreground="White"
                   BorderThickness="0"
                   Click="CancelButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#757575"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
